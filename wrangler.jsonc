{
  // Cloudflare Worker: serves the built site (npm run build -> dist/) and handles POST /api/subscribe.
  // The Brevo key is NOT stored here. Add it as a secret named BREVO_API_KEY
  // (Cloudflare dashboard > Workers > marketing > Settings > Variables and secrets,
  //  or: npx wrangler secret put BREVO_API_KEY).
  "name": "marketing",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Build the Astro site before every deploy, so dist/ is always fresh.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_LIST_NAME": "newsletter sign ups",
    // Brevo list ID (Contacts > Lists). When set, the Worker skips the name lookup.
    "BREVO_LIST_ID": "5",
    // Brevo list for the free tools & resources pop-up (/marketing-tools)
    "BREVO_FREEBIES_LIST_ID": "6"
  }
}
