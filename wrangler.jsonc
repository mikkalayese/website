{
  // Cloudflare Worker: serves this static site and handles POST /api/subscribe.
  // The Brevo key is NOT stored here. Add it as a secret named BREVO_API_KEY
  // (Cloudflare dashboard > Workers > website > Settings > Variables and secrets,
  //  or: npx wrangler secret put BREVO_API_KEY).
  "name": "website",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_LIST_NAME": "su primera lista"
  }
}
