{
  // Cloudflare Worker: serves this static site and handles POST /api/subscribe.
  // The Brevo key is NOT stored here. Add it as a secret named BREVO_API_KEY
  // (Cloudflare dashboard > Workers > marketing > Settings > Variables and secrets,
  //  or: npx wrangler secret put BREVO_API_KEY).
  "name": "marketing",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BREVO_LIST_NAME": "newsletter sign ups",
    // Brevo list ID (Contacts > Lists). When set, the Worker skips the name lookup.
    "BREVO_LIST_ID": "5"
  }
}
