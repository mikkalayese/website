---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PillarFilters from '../components/PillarFilters.astro';
import HatOtter from '../components/HatOtter.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---
<Base title={'Mikka — Marketing that works without a full team or a full-time week'} ogTitle={'Get real results without becoming an expert in everything — Mikka'} current="home">

    <!-- ============ HERO ============ -->
    <section class="hero hero--home" id="top">
      <div class="container hero__grid">

        <p class="eyebrow hero__eyebrow reveal-up">
          <span class="pulse" aria-hidden="true"></span>
          Work-Life · Hacking
        </p>

        <h1 class="hero__title" aria-label="Marketing that works without a full team or a full-time week">
          <span class="line"><span class="line__inner">Get <em>the job done</em> without hiring experts</span></span>
        </h1>

        <div class="hero__copy reveal-up" style="--d: .55s">
          <p class="lead">
            I figure out how marketing, AI and systems work, test them on real problems, and share what actually worked.
            One experiment a week, for people who'd rather figure it out themselves than wait on an expert.
          </p>

          <form class="signup" data-signup novalidate>
            <label class="sr-only" for="hero-email">Your email</label>
            <input id="hero-email" type="email" name="email" placeholder="Your email" autocomplete="email" required>
            <button type="submit" class="btn btn--accent">Get the weekly experiment</button>
            <p class="signup__msg" role="status" aria-live="polite"></p>
          </form>
          <p class="micro">Free. One email a week. Unsubscribe anytime.</p>
          <!-- Later, once the number is worth showing: <p class="micro">Join [X] founders and marketers.</p> -->
          <a href="#experiments" class="link-arrow">Or read past experiments <span aria-hidden="true">↓</span></a>
        </div>

        <div class="hero__media reveal-up" style="--d: .75s">
          <div class="video">
            <iframe src="https://www.youtube-nocookie.com/embed/crrHRV-HEkg?rel=0&amp;modestbranding=1&amp;playsinline=1"
                    title="Mikka: figuring things out"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
          </div>
          <div class="chip chip--float chip--a">Problem → Figure it out</div>
          <div class="chip chip--float chip--b">Build a system → Share it</div>
        </div>

      </div>
    </section>

    <!-- ============ MARQUEE ============ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Work Hacking</span><i>✦</i><span>Skill Hacking</span><i>✦</i><span>Leverage Hacking</span><i>✦</i><span>Life Hacking</span><i>✦</i>
        <span>Work Hacking</span><i>✦</i><span>Skill Hacking</span><i>✦</i><span>Leverage Hacking</span><i>✦</i><span>Life Hacking</span><i>✦</i>
      </div>
    </div>

    <!-- ============ WHO IT'S FOR ============ -->
    <section class="section" id="who">
      <div class="container">
        <div class="section__head who__head">
          <div class="reveal">
            <p class="eyebrow">01 — Who it's for</p>
            <h2 class="h2">You wear twenty hats. Let’s make <em>marketing</em> and systems ones fit better.</h2>
          </div>
          <div class="who__mascot reveal" style="--d:.15s"><HatOtter /></div>
        </div>

        <div class="cards-2">
          <article class="card reveal">
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
            </div>
            <h3 class="h3">Founders &amp; small-business owners</h3>
            <p>You know you should be able to do your own marketing, but you don't have the time or a clear path.</p>
          </article>
          <article class="card reveal" style="--d:.1s">
            <div class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <h3 class="h3">Early-career marketers</h3>
            <p>You're trying to become useful fast, without burning out.</p>
          </article>
        </div>

        <blockquote class="statement reveal">
          You don't need to know everything.<br>
          You need to know how to <em>figure things out.</em>
        </blockquote>
      </div>
    </section>

    <!-- ============ WHAT YOU GET ============ -->
    <section class="section section--tint" id="get">
      <div class="container get">
        <div class="get__copy reveal">
          <p class="eyebrow">02 — What you get each week</p>
          <h2 class="h2">One real experiment, <em>written up properly.</em></h2>
          <p class="lead">
            I take a problem I actually had, work out the simplest way to solve it, and send you the whole thing.
          </p>
          <p class="note">No "5 frameworks you should know." Just what I tried and what happened.</p>
        </div>

        <div class="issue reveal" style="--d:.1s">
          <div class="issue__bar">
            <span></span><span></span><span></span>
            <p>Experiment #[N] · Inbox</p>
          </div>
          <ol class="issue__list">
            <li><span class="issue__n">01</span><div><strong>The problem</strong><p>In two lines.</p></div></li>
            <li><span class="issue__n">02</span><div><strong>How I figured it out</strong><p>Including what I didn't know and what I skipped.</p></div></li>
            <li><span class="issue__n">03</span><div><strong>A template or checklist</strong><p>You can steal it.</p></div></li>
            <li><span class="issue__n">04</span><div><strong>The result</strong><p>Real numbers, or an honest "it half worked."</p></div></li>
            <li><span class="issue__n">05</span><div><strong>One takeaway</strong><p>Something you can reuse.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ============ SIGNUP (mid-page) ============ -->
    <section class="cta" id="subscribe">
      <div class="container cta__inner reveal">
        <p class="eyebrow eyebrow--light">The newsletter</p>
        <h2 class="cta__title">Become Dangerously <br><em> Resourceful</em></h2>
        <p class="cta__sub">After a few issues, you should be thinking: <em>this is simpler than I thought, and I don't need to know everything.</em></p>
        <form class="signup signup--light" data-signup novalidate>
          <label class="sr-only" for="mid-email">Your email</label>
          <input id="mid-email" type="email" name="email" placeholder="Your email" autocomplete="email" required>
          <button type="submit" class="btn btn--accent">Send me the next experiment</button>
          <p class="signup__msg" role="status" aria-live="polite"></p>
        </form>
        <!-- TODO: replace with your LinkedIn newsletter URL -->
        <a class="micro micro--light link-quiet" href="https://www.linkedin.com/in/mikkalayese" target="_blank" rel="noopener">Prefer LinkedIn? Subscribe there instead.</a>
      </div>
    </section>

    <!-- ============ HOW I WORK ============ -->
    <section class="section" id="how">
      <div class="container">
        <div class="section__head reveal">
          <p class="eyebrow">03 — How I work</p>
          <h2 class="h2">80% of expert-level results, <em>without spending 100% of the time trying to be one</em></h2>
        </div>

        <ol class="steps" data-steps>
          <li class="step reveal"><span class="step__n">01</span><span class="step__t">Learn</span></li>
          <li class="step reveal" style="--d:.06s"><span class="step__n">02</span><span class="step__t">Think</span></li>
          <li class="step reveal" style="--d:.12s"><span class="step__n">03</span><span class="step__t">Simplify</span></li>
          <li class="step reveal" style="--d:.18s"><span class="step__n">04</span><span class="step__t">Find leverage</span></li>
          <li class="step reveal" style="--d:.24s"><span class="step__n">05</span><span class="step__t">Build a system</span></li>
          <li class="step reveal" style="--d:.30s"><span class="step__n">06</span><span class="step__t">Make it happen</span></li>
        </ol>

        <div class="how__foot reveal">
          <p class="lead">
            I make the 80 - 20 rule work for you without becoming an expert in everything, then embed the repeatable system.
          </p>
          <div class="meter" aria-hidden="true">
            <div class="meter__bar"><span data-meter></span></div>
            <div class="meter__labels"><span>“I have no idea how to do this”</span><span>“I figured it out”</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ EXPERIMENTS ============ -->
    <section class="section section--tint" id="experiments" data-filter-scope>
      <div class="container">
        <div class="section__head section__head--row reveal">
          <div>
            <p class="eyebrow">04 — Experiments</p>
            <h2 class="h2">Build the skill, ship the project, <em> skip the learning curve.</em></h2>
          </div>
          <div class="section__aside">
            <p>Client details are generalized. The lessons aren't.</p>
            <a href="/blog" class="link-arrow">Read all posts <span aria-hidden="true">→</span></a>
          </div>
        </div>

        {posts.length > 0 ? (
          <>
            <PillarFilters label="Filter experiments by pillar" />
            <div class="post-grid" data-limit="6">
              {posts.map((post, i) => <PostCard post={post} delay={Math.min(i, 5) * 0.06} />)}
            </div>
            <p class="note filter-empty" data-filter-empty hidden>No experiments in this pillar yet. <a href="/blog" class="link-underline">See all posts</a>.</p>
          </>
        ) : (
          <p class="note reveal">The first experiment is on its way. Subscribe below to get it first.</p>
        )}

        <!-- Second signup, under the last card -->
        <div class="inline-signup reveal">
          <p class="inline-signup__title">Get one of these in your inbox every week.</p>
          <form class="signup" data-signup novalidate>
            <label class="sr-only" for="exp-email">Your email</label>
            <input id="exp-email" type="email" name="email" placeholder="Your email" autocomplete="email" required>
            <button type="submit" class="btn btn--dark">Send me the next experiment</button>
            <p class="signup__msg" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="section" id="about">
      <div class="container about">
        <div class="about__media reveal">
          <div class="portrait">
            <img src="/assets/mikka.webp" width="864" height="1184" loading="lazy" alt="Mikka holding up blue heart-shaped sunglasses">
          </div>
          <div class="stat">
            <span class="stat__n">4M+</span>
            <span class="stat__l">views on my comedy channel</span>
          </div>
        </div>
        <div class="about__copy reveal" style="--d:.1s">
          <p class="eyebrow">05 — About</p>
          <h2 class="h2">Hi, I'm Mikka.</h2>
          <p class="lead">
            A marketer with <span class="ph">[X years]</span> of experience across <span class="ph">[startups, SaaS, ecommerce]</span>.
            Most of what I know, I learned by needing it and figuring it out. I also run a comedy channel with 4M+ views, so I've learned what makes content travel.
          </p>
          <p>
            This newsletter is where I document the experiments: marketing, AI, systems, and how to build a life that doesn't get optimized into misery.
          </p>
          <ul class="pillars">
            <li><span class="tag tag--work">Work Hacking</span></li>
            <li><span class="tag tag--skill">Skill Hacking</span></li>
            <li><span class="tag tag--leverage">Leverage Hacking</span></li>
            <li><span class="tag tag--life">Life Hacking</span></li>
          </ul>
          <a href="/marketing-tools" class="btn btn--dark about__cta">View free tools &amp; resources <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>



    <!-- ============ WORK WITH ME (demoted) ============ -->
    <div class="quiet-line reveal">
      <div class="container">
        <p>Need it done rather than figured out? <a href="/work-with-me" class="link-underline">Work with me</a>.</p>
      </div>
    </div>

</Base>
