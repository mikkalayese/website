---
import Base from '../layouts/Base.astro';

// Font choices for the quote image (all Google Fonts, loaded only on this page).
const MAIN_FONTS = ['Inter Tight', 'Poppins', 'Montserrat', 'Playfair Display', 'Lora'];
const ACCENT_FONTS = ['Caveat', 'Dancing Script', 'Pacifico', 'Permanent Marker', 'Shadows Into Light'];
const fontsHref = 'https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&family=Montserrat:wght@500;600&family=Playfair+Display:wght@500;600&family=Lora:wght@500;600&family=Dancing+Script:wght@600&family=Pacifico&family=Permanent+Marker&family=Shadows+Into+Light&display=swap';
---
<Base
  title="Image quote template — Mikka"
  description="Free image quote template: type a quote, pick your colours, download a ready-to-post image for Instagram, LinkedIn or Stories."
  current="tools"
>
  <link slot="head" rel="stylesheet" href={fontsHref}>
  <section class="blog-head">
    <div class="container">
      <p class="qt-back"><a href="/marketing-tools" class="link-arrow"><span aria-hidden="true">←</span> All free tools</a></p>
      <p class="eyebrow reveal-up">Free tool</p>
      <h1 class="blog-title reveal-up" style="--d:.1s">Image quote <em>template.</em></h1>
      <p class="lead reveal-up" style="--d:.18s">Type your quote, pick your colours, download a ready-to-post image.</p>
    </div>
  </section>

  <section class="section section--tint quote-tool-section">
    <div class="container quote-tool" data-quote-tool>
      <form class="qt-controls" onsubmit="return false">
        <div class="qt-field">
          <label for="qt-quote">Quote</label>
          <textarea id="qt-quote" rows="5" maxlength="320">You don't need to know everything. You need to know how to *figure things out.*</textarea>
          <p class="qt-hint">Wrap words in *asterisks* to make them handwritten.</p>
        </div>
        <div class="qt-row">
          <div class="qt-field">
            <label for="qt-author">Name</label>
            <input id="qt-author" type="text" maxlength="60" value="Mikka Layese">
          </div>
          <div class="qt-field">
            <label for="qt-handle">Handle or website</label>
            <input id="qt-handle" type="text" maxlength="60" value="@mikkalayese">
          </div>
        </div>

        <div class="qt-row">
          <div class="qt-field">
            <label for="qt-font-main">Main font</label>
            <select id="qt-font-main">
              {MAIN_FONTS.map((f) => <option value={f} style={`font-family:'${f}'`}>{f}</option>)}
            </select>
          </div>
          <div class="qt-field">
            <label for="qt-font-accent">Secondary font</label>
            <select id="qt-font-accent">
              {ACCENT_FONTS.map((f) => <option value={f} style={`font-family:'${f}'`}>{f}</option>)}
            </select>
          </div>
        </div>
        <p class="qt-hint qt-hint--tight">The secondary font is used for the *highlighted* words.</p>

        <fieldset class="qt-field">
          <legend>Size</legend>
          <div class="qt-seg">
            <label><input type="radio" name="qt-size" value="1080x1080" checked><span>Square<small>1080×1080</small></span></label>
            <label><input type="radio" name="qt-size" value="1080x1350"><span>Portrait<small>1080×1350</small></span></label>
            <label><input type="radio" name="qt-size" value="1080x1920"><span>Story<small>1080×1920</small></span></label>
          </div>
        </fieldset>

        <fieldset class="qt-field">
          <legend>Alignment</legend>
          <div class="qt-seg qt-seg--sm">
            <label><input type="radio" name="qt-align" value="left" checked><span>Left</span></label>
            <label><input type="radio" name="qt-align" value="center"><span>Centre</span></label>
          </div>
        </fieldset>

        <div class="qt-field">
          <label class="qt-check"><input type="checkbox" id="qt-show-mark" checked><span>Show quote mark</span></label>
        </div>

        <fieldset class="qt-field">
          <legend>Colour themes</legend>
          <div class="qt-themes">
            <button type="button" class="qt-theme is-active" data-theme="#ffffff,#121212,#ee3d4c" aria-label="White"><span class="qt-swatches"><span style="background:#ffffff"></span><span style="background:#121212"></span><span style="background:#ee3d4c"></span></span>White</button>
            <button type="button" class="qt-theme" data-theme="#e8f1f8,#121212,#ee3d4c" aria-label="Ice"><span class="qt-swatches"><span style="background:#e8f1f8"></span><span style="background:#121212"></span><span style="background:#ee3d4c"></span></span>Ice</button>
            <button type="button" class="qt-theme" data-theme="#121212,#ffffff,#ee3d4c" aria-label="Ink"><span class="qt-swatches"><span style="background:#121212"></span><span style="background:#ffffff"></span><span style="background:#ee3d4c"></span></span>Ink</button>
            <button type="button" class="qt-theme" data-theme="#ee3d4c,#ffffff,#121212" aria-label="Red"><span class="qt-swatches"><span style="background:#ee3d4c"></span><span style="background:#ffffff"></span><span style="background:#121212"></span></span>Red</button>
          </div>
        </fieldset>

        <fieldset class="qt-field">
          <legend>Adjust colours</legend>
          <div class="qt-colors">
            <label><input type="color" id="qt-bg" value="#ffffff"><span>Background</span></label>
            <label><input type="color" id="qt-text" value="#121212"><span>Text</span></label>
            <label><input type="color" id="qt-accent" value="#ee3d4c"><span>Accent</span></label>
          </div>
        </fieldset>

        <fieldset class="qt-field">
          <legend>Logo</legend>
          <label class="qt-check"><input type="checkbox" id="qt-show-logo" checked><span>Show logo</span></label>
          <div class="qt-logo">
            <div class="qt-logo__preview" data-qt-logo-preview><span class="qt-logo__default">mikka<b>.</b></span></div>
            <div class="qt-logo__buttons">
              <label class="btn btn--ghost btn--sm qt-logo__upload">Upload logo<input type="file" id="qt-logo" accept="image/png,image/jpeg,image/webp,image/svg+xml"></label>
              <button type="button" class="qt-logo__remove link-underline" data-qt-logo-remove hidden>Use default logo</button>
            </div>
          </div>
          <p class="qt-hint">Untick "Show logo" to remove it from the image. PNG or SVG with a transparent background works best, and your logo stays on your device.</p>
        </fieldset>

        <div class="qt-actions">
          <button type="button" class="btn btn--accent" data-qt-download="png">Download PNG</button>
          <button type="button" class="btn btn--dark" data-qt-download="svg">Download SVG</button>
          <button type="button" class="btn btn--ghost" data-qt-reset>Reset</button>
        </div>
        <p class="qt-hint" data-qt-status role="status" aria-live="polite"></p>
      </form>

      <div class="qt-preview">
        <div class="qt-canvas-wrap"><canvas id="qt-canvas" width="1080" height="1080" aria-label="Quote image preview"></canvas></div>
        <p class="qt-hint qt-size-label">Preview · <span data-qt-size-label>1080×1080 px</span></p>
      </div>
    </div>
  </section>

  <script is:inline src="/assets/quote-tool.js" defer></script>
</Base>
