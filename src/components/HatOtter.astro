---
// "You wear twenty hats": the otter tries on one hat after another.
// Swap the image for the animated GIF by changing `src` (e.g. /assets/otter.gif).
interface Props { src?: string }
const { src = '/assets/otter.webp' } = Astro.props;
---
<figure class="hat-otter" aria-label="An otter trying on one hat after another">
  <div class="hat-otter__body">
    <img src={src} alt="" width="480" height="480" loading="lazy" decoding="async">
    <div class="hat-otter__head" aria-hidden="true">
      <!-- Top hat -->
      <svg class="hat hat--1" viewBox="0 0 100 80"><rect x="28" y="6" width="44" height="52" rx="5" fill="#121212"/><rect x="28" y="40" width="44" height="10" fill="#EE3D4C"/><ellipse cx="50" cy="60" rx="46" ry="11" fill="#121212"/></svg>
      <!-- Cap -->
      <svg class="hat hat--2" viewBox="0 0 100 80"><path d="M16 58 C16 24 84 24 84 58 Z" fill="#EE3D4C"/><path d="M60 56 C76 52 96 54 98 62 C88 66 70 66 60 62 Z" fill="#c92b39"/><circle cx="50" cy="30" r="4" fill="#121212"/><path d="M50 30 L50 58" stroke="#c92b39" stroke-width="2"/></svg>
      <!-- Beanie -->
      <svg class="hat hat--3" viewBox="0 0 100 80"><path d="M18 60 C18 22 82 22 82 60 Z" fill="#cfe2f1"/><circle cx="50" cy="27" r="9" fill="#121212"/><rect x="14" y="52" width="72" height="16" rx="7" fill="#9ec3e0"/><path d="M26 54v12M38 54v12M50 54v12M62 54v12M74 54v12" stroke="#7fb0d6" stroke-width="3"/></svg>
      <!-- Chef hat -->
      <svg class="hat hat--4" viewBox="0 0 100 80"><path d="M28 60 L28 40 C14 40 12 18 30 18 C34 4 66 4 70 18 C88 18 86 40 72 40 L72 60 Z" fill="#fff" stroke="#121212" stroke-width="3"/><rect x="28" y="56" width="44" height="12" rx="3" fill="#fff" stroke="#121212" stroke-width="3"/></svg>
      <!-- Graduation cap -->
      <svg class="hat hat--5" viewBox="0 0 100 80"><path d="M50 14 L96 32 L50 50 L4 32 Z" fill="#121212"/><path d="M26 42 L26 58 C36 66 64 66 74 58 L74 42 L50 52 Z" fill="#2a2a2a"/><path d="M84 36 L84 60" stroke="#EE3D4C" stroke-width="3"/><circle cx="84" cy="62" r="4" fill="#EE3D4C"/></svg>
    </div>
  </div>
</figure>
